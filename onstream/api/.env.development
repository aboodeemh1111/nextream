# --- Self-hosted storage bucket (local MinIO via docker-compose.dev.yml) -----
# Start it from the repo root:  docker compose -f docker-compose.dev.yml up -d
# minioadmin/minioadmin are MinIO's documented local defaults, not secrets.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nextream-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MEDIA_URL_TTL_VIDEO=21600
MEDIA_URL_TTL_IMAGE=86400
MEDIA_MAX_UPLOAD_MB=4096
