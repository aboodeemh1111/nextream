# Runtime configuration for the containerized API.
#
#   cp .env.docker.example .env.docker    # then fill in the blanks
#
# Used by the production-shaped stack at the repo root:
#   docker compose up -d
#
# The local dev stack (docker-compose.dev.yml) does NOT read this file — it
# reuses the existing .env / .env.development and points storage at the MinIO
# container. Nothing here is read at build time; the image carries no secrets.

# --- core -------------------------------------------------------------------
NODE_ENV=production
PORT=8800

# Any MongoDB URI reachable from the container. Note that index.js hardcodes
# dbName: 'streamo', so the database name in the URI is ignored.
#   Atlas:                mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
#   mongo sidecar:        mongodb://mongo:27017
MONGO_URL=

# JWT signing key (routes/auth.js, verifyToken.js). Use a long random value.
SECRET_KEY=

# --- media storage (S3 / MinIO) ---------------------------------------------
STORAGE_DRIVER=s3

# Where the API itself reaches the bucket. Inside a container `localhost` is the
# container, so a sidecar MinIO is http://minio:9000 — never http://localhost:9000.
S3_ENDPOINT=

# Where the *browser* reaches the bucket. Presigned URLs are signed over the Host
# header, so if the two differ, this one has to be set or every signature breaks
# on arrival. Leave empty when the API and browser use the same host.
S3_PUBLIC_ENDPOINT=

S3_REGION=us-east-1
S3_BUCKET=nextream-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO and any endpoint without virtual-host-style bucket DNS.
S3_FORCE_PATH_STYLE=true

# Presigned URL lifetimes, seconds. Video is short because the URL travels with
# the player; images are cached longer.
MEDIA_URL_TTL_VIDEO=21600
MEDIA_URL_TTL_IMAGE=86400
MEDIA_MAX_UPLOAD_MB=4096
# Optional allowlist of external hosts that may appear in stored media URLs
# (comma-separated). Leave unset to keep the built-in default.
# MEDIA_ALLOWED_URL_HOSTS=

# --- push notifications (optional) ------------------------------------------
# Without all three, firebase.js logs a warning and push delivery is skipped;
# everything else keeps working.
#
# Leave the private key UNQUOTED: one line, literal \n escapes, no surrounding
# double quotes. firebase.js turns the escapes into real newlines itself. Quotes
# are the trap here — compose strips them but `docker run --env-file` does not,
# and a key that arrives still wrapped in quotes fails to parse. It fails late,
# too: initializeApp() accepts it and only the first push send throws
# "error:1E08010C:DECODER routines::unsupported".
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# --- notification scheduler (optional) --------------------------------------
# Set NOTIFICATIONS_DISABLED=true to silence the feature entirely, or
# NOTIFY_SCHEDULER=false to keep writing notifications while stopping the
# background drain/sweep timers — useful when running more than one API replica
# and only one should own them.
# NOTIFICATIONS_DISABLED=
# NOTIFY_SCHEDULER=
# NOTIFY_DEFERRED_INTERVAL_MS=
# NOTIFY_SWEEP_INTERVAL_MS=
# NOTIFY_COALESCE_MS=
